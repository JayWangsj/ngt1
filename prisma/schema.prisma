generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  STAFF
}

enum Status {
  RECEIVED
  DIAGNOSING
  REPAIRING
  PARTS_MISSING
  READY
  COMPLETED
  REWORKING
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum PaymentKind {
  DEPOSIT
  BALANCE
  SALE
  OTHER
  AFTER_SALES
  REFUND
}

enum RevenueSource {
  REPAIR
  RETAIL
  QUICK_SERVICE
}

enum WorkOrderType {
  REPAIR
  QUICK_SERVICE
}

enum ProductUsage {
  RETAIL
  REPAIR
}

enum InventoryMovementType {
  INITIAL_STOCK
  STOCK_IN
  RETAIL_SALE
  REPAIR_USE
  SALE_RETURN
  MANUAL_ADJUSTMENT
}

enum WorkOrderProductKind {
  REPAIR_PART
  RETAIL_ADDON
}

enum ReworkTreatment {
  WARRANTY
  PAID
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String
  passwordHash       String
  role               Role                @default(STAFF)
  enabled            Boolean             @default(true)
  failedAttempts     Int                 @default(0)
  lockedUntil        DateTime?           @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  payments           Payment[]
  statuses           StatusHistory[]
  audits             AuditLog[]
  inventoryMovements InventoryMovement[]
  retailSales        RetailSale[]
}

model Customer {
  id             String          @id @default(cuid())
  name           String
  phone          String
  consentAt      DateTime?       @db.Timestamptz(3)
  consentVersion String?
  codiceFiscale  String?
  partitaIva     String?
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  devices        Device[]
  phones         CustomerPhone[]
  deletedAt      DateTime?       @db.Timestamptz(3)
}

model CustomerPhone {
  phone      String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([phone, customerId])
  @@index([customerId])
}

model Device {
  id            String            @id @default(cuid())
  customerId    String
  customer      Customer          @relation(fields: [customerId], references: [id])
  category      String            @default("PHONE")
  brand         String
  series        String            @default("")
  model         String
  imei          String?
  appearance    String            @default("")
  accessories   String            @default("")
  orders        WorkOrder[]
  relatedOrders WorkOrderDevice[]
  deletedAt     DateTime?         @db.Timestamptz(3)

  @@index([customerId])
}

model WorkOrder {
  id                String             @id @default(cuid())
  number            Int                @unique @default(autoincrement())
  code              String             @unique
  type              WorkOrderType      @default(REPAIR)
  customerName      String             @default("")
  deviceId          String
  device            Device             @relation(fields: [deviceId], references: [id])
  status            Status             @default(RECEIVED)
  orderDiscount     Decimal            @default(0) @db.Decimal(12, 2)
  includeVat        Boolean            @default(false)
  inspectionMode    Boolean            @default(false)
  inspectionFee     Decimal            @default(0) @db.Decimal(12, 2)
  inspectionResult  String             @default("")
  faultNote         String             @default("")
  fault             String
  appearance        String             @default("")
  accessories       String             @default("")
  notes             String             @default("")
  dueDate           String?
  expectedAt        String?
  confirmedAt       DateTime?          @db.Timestamptz(3)
  confirmationNote  String             @default("")
  pickedUpAt        DateTime?          @db.Timestamptz(3)
  pickedUpBy        String?
  warrantyMonths    Int                @default(0)
  warrantyDays      Int                @default(0)
  warrantyScope     String             @default("")
  warrantyNotes     String             @default("")
  afterSalesFee     Decimal            @default(0) @db.Decimal(12, 2)
  afterSalesDueDate String?
  afterSalesOpen    Boolean            @default(false)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  items             WorkOrderItem[]
  faults            WorkOrderFault[]
  products          WorkOrderProduct[]
  payments          Payment[]
  history           StatusHistory[]
  reworks           ReworkSession[]
  relatedDevices    WorkOrderDevice[]

  @@index([status, dueDate])
  @@index([deviceId])
  @@index([createdAt])
}

model PriceRule {
  id                String            @id @default(cuid())
  category          String            @default("PHONE")
  brand             String            @default("")
  series            String            @default("")
  model             String            @default("")
  project           String
  suggested         Decimal           @db.Decimal(12, 2)
  cost              Decimal?          @db.Decimal(12, 2)
  minutes           Int               @default(60)
  enabled           Boolean           @default(true)
  notes             String            @default("")
  requiredProductId String?
  requiredProduct   Product?          @relation("RequiredRepairProduct", fields: [requiredProductId], references: [id])
  requiredQuantity  Int               @default(1)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  items             WorkOrderItem[]
  options           PriceRuleOption[]

  @@unique([category, brand, series, model, project])
}

model PriceRuleOption {
  id           String          @id @default(cuid())
  ruleId       String
  rule         PriceRule       @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  name         String
  suggested    Decimal         @db.Decimal(12, 2)
  cost         Decimal?        @db.Decimal(12, 2)
  quantity     Int             @default(1)
  minutes      Int             @default(60)
  warrantyDays Int             @default(0)
  enabled      Boolean         @default(true)
  isDefault    Boolean         @default(false)
  sortOrder    Int             @default(0)
  notes        String          @default("")
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  items        WorkOrderItem[]

  @@unique([ruleId, productId])
  @@index([ruleId, enabled, sortOrder])
  @@index([productId])
}

model WorkOrderItem {
  id                  String           @id @default(cuid())
  orderId             String
  order               WorkOrder        @relation(fields: [orderId], references: [id])
  ruleId              String?
  rule                PriceRule?       @relation(fields: [ruleId], references: [id])
  priceOptionId       String?
  priceOption         PriceRuleOption? @relation(fields: [priceOptionId], references: [id], onDelete: Restrict)
  priceOptionName     String           @default("")
  quickServiceId      String?
  quickService        QuickService?    @relation(fields: [quickServiceId], references: [id], onDelete: SetNull)
  project             String
  suggested           Decimal?         @db.Decimal(12, 2)
  discount            Decimal          @default(0) @db.Decimal(12, 2)
  final               Decimal          @db.Decimal(12, 2)
  matchLevel          String
  adjustmentReason    String           @default("")
  minutes             Int              @default(0)
  requiredProductId   String?
  requiredProductName String           @default("")
  requiredQuantity    Int              @default(1)
  requiredProduct     Product?         @relation("RequiredWorkOrderProduct", fields: [requiredProductId], references: [id])
  warrantyStart       DateTime?        @db.Timestamptz(3)
  warrantyDays        Int              @default(0)
  warrantyExpiresAt   DateTime?        @db.Timestamptz(3)
  warrantyNotes       String           @default("")
  reworkItem          ReworkItem?

  @@index([orderId])
  @@index([requiredProductId])
  @@index([priceOptionId])
  @@index([quickServiceId])
}

model WorkOrderDevice {
  orderId  String
  order    WorkOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deviceId String
  device   Device    @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@id([orderId, deviceId])
  @@index([deviceId])
}

model Payment {
  id              String              @id @default(cuid())
  requestId       String              @unique
  orderId         String?
  order           WorkOrder?          @relation(fields: [orderId], references: [id])
  saleId          String?
  sale            RetailSale?         @relation(fields: [saleId], references: [id])
  amount          Decimal             @db.Decimal(12, 2)
  method          PaymentMethod
  kind            PaymentKind
  receivedAt      DateTime            @default(now()) @db.Timestamptz(3)
  actorId         String
  actor           User                @relation(fields: [actorId], references: [id])
  actorName       String
  allocations     PaymentAllocation[]
  reworkSessionId String?
  reworkSession   ReworkSession?      @relation(fields: [reworkSessionId], references: [id])

  @@index([orderId])
  @@index([saleId])
  @@index([receivedAt])
  @@index([reworkSessionId])
}

model ReworkSession {
  id         String       @id @default(cuid())
  orderId    String
  order      WorkOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receivedAt DateTime     @default(now()) @db.Timestamptz(3)
  dueDate    String?
  notes      String       @default("")
  open       Boolean      @default(true)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)
  items      ReworkItem[]
  payments   Payment[]

  @@index([orderId, createdAt])
}

model ReworkItem {
  id                String          @id @default(cuid())
  sessionId         String
  session           ReworkSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  originalItemId    String          @unique
  originalItem      WorkOrderItem   @relation(fields: [originalItemId], references: [id], onDelete: Restrict)
  warrantyState     String
  treatment         ReworkTreatment
  fee               Decimal         @default(0) @db.Decimal(12, 2)
  requiredProductId String?
  requiredProduct   Product?        @relation(fields: [requiredProductId], references: [id], onDelete: Restrict)
  requiredQuantity  Int             @default(1)

  @@index([sessionId])
  @@index([requiredProductId])
}

model StatusHistory {
  id        String    @id @default(cuid())
  orderId   String
  order     WorkOrder @relation(fields: [orderId], references: [id])
  from      Status?
  to        Status
  actorId   String
  actor     User      @relation(fields: [actorId], references: [id])
  actorName String
  note      String    @default("")
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([orderId])
}

model AuditLog {
  id        String   @id @default(cuid())
  entityId  String
  action    String
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  actorName String
  context   Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityId, createdAt])
}

model FaultOption {
  id        String           @id @default(cuid())
  category  String
  name      String
  key       String
  note      String           @default("")
  sortOrder Int              @default(0)
  hidden    Boolean          @default(false)
  orders    WorkOrderFault[]

  @@unique([category, key])
  @@index([category, hidden, sortOrder])
}

model WorkOrderFault {
  id           String       @id @default(cuid())
  orderId      String
  order        WorkOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  catalogId    String?
  catalog      FaultOption? @relation(fields: [catalogId], references: [id], onDelete: Restrict)
  nameSnapshot String
  custom       Boolean      @default(false)

  @@index([orderId])
  @@index([catalogId])
}

model Product {
  id                String                 @id @default(cuid())
  name              String
  category          String
  usage             ProductUsage
  costPrice         Decimal                @db.Decimal(12, 2)
  salePrice         Decimal                @db.Decimal(12, 2)
  stockQuantity     Int                    @default(0)
  minStock          Int                    @default(0)
  favorite          Boolean                @default(false)
  enabled           Boolean                @default(true)
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(3)
  movements         InventoryMovement[]
  saleItems         RetailSaleItem[]
  workOrderProducts WorkOrderProduct[]
  requiredByRules   PriceRule[]            @relation("RequiredRepairProduct")
  requiredByItems   WorkOrderItem[]        @relation("RequiredWorkOrderProduct")
  priceRuleOptions  PriceRuleOption[]
  reworkItems       ReworkItem[]
  compatibilities   ProductCompatibility[]

  @@index([name])
  @@index([category, usage, enabled])
  @@index([enabled, favorite])
}

model ProductCompatibility {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  category  String
  brand     String
  model     String
  project   String  @default("")

  @@unique([productId, category, brand, model, project])
  @@index([category, brand, model])
}

model QuickService {
  id           String              @id @default(cuid())
  name         String
  defaultPrice Decimal             @db.Decimal(12, 2)
  notes        String              @default("")
  enabled      Boolean             @default(true)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)
  workItems    WorkOrderItem[]
  retailItems  RetailServiceItem[]

  @@index([enabled, name])
}

model InventoryCategory {
  id         String    @id @default(cuid())
  name       String    @unique
  repairOnly Boolean   @default(false)
  deletedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
}

model DeviceCatalogDeletion {
  id        String   @id @default(cuid())
  category  String
  kind      String
  brand     String   @default("")
  value     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([category, kind, brand, value])
}

model BusinessClock {
  id         String   @id @default("default")
  mode       String   @default("SYSTEM")
  manualDate String?
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
}

model RetailSale {
  id           String              @id @default(cuid())
  number       Int                 @unique @default(autoincrement())
  code         String              @unique
  requestId    String              @unique
  subtotal     Decimal             @db.Decimal(12, 2)
  discount     Decimal             @default(0) @db.Decimal(12, 2)
  total        Decimal             @db.Decimal(12, 2)
  itemCount    Int
  actorId      String
  actor        User                @relation(fields: [actorId], references: [id])
  actorName    String
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  items        RetailSaleItem[]
  serviceItems RetailServiceItem[]
  payments     Payment[]

  @@index([createdAt])
}

model RetailServiceItem {
  id             String        @id @default(cuid())
  saleId         String
  sale           RetailSale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  quickServiceId String?
  quickService   QuickService? @relation(fields: [quickServiceId], references: [id], onDelete: SetNull)
  serviceName    String
  notes          String        @default("")
  unitPrice      Decimal       @db.Decimal(12, 2)
  quantity       Int           @default(1)
  subtotal       Decimal       @db.Decimal(12, 2)

  @@index([saleId])
  @@index([quickServiceId])
}

model RetailSaleItem {
  id          String     @id @default(cuid())
  saleId      String
  sale        RetailSale @relation(fields: [saleId], references: [id])
  productId   String
  product     Product    @relation(fields: [productId], references: [id])
  productName String
  category    String
  unitPrice   Decimal    @db.Decimal(12, 2)
  quantity    Int
  subtotal    Decimal    @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
}

model PaymentAllocation {
  id        String        @id @default(cuid())
  paymentId String
  payment   Payment       @relation(fields: [paymentId], references: [id])
  source    RevenueSource
  amount    Decimal       @db.Decimal(12, 2)

  @@unique([paymentId, source])
  @@index([source])
}

model WorkOrderProduct {
  id          String               @id @default(cuid())
  orderId     String
  order       WorkOrder            @relation(fields: [orderId], references: [id])
  productId   String
  product     Product              @relation(fields: [productId], references: [id])
  productName String
  category    String
  kind        WorkOrderProductKind
  contextKey  String               @default("ORIGINAL")
  unitPrice   Decimal              @db.Decimal(12, 2)
  discount    Decimal              @default(0) @db.Decimal(12, 2)
  quantity    Int
  consumedAt  DateTime?            @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)

  @@unique([orderId, productId, kind, contextKey])
  @@index([orderId])
  @@index([productId])
}

model InventoryMovement {
  id            String                @id @default(cuid())
  requestId     String                @unique
  productId     String
  product       Product               @relation(fields: [productId], references: [id])
  quantity      Int
  stockBefore   Int
  stockAfter    Int
  type          InventoryMovementType
  referenceType String?
  referenceId   String?
  note          String                @default("")
  actorId       String
  actor         User                  @relation(fields: [actorId], references: [id])
  actorName     String
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)

  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}
